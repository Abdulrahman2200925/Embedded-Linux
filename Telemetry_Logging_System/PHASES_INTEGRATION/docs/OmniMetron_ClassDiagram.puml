' ═══════════════════════════════════════════════════════════════
' PHASE 6 -- FAÇADE · CONFIG · SYSTEM
' ═══════════════════════════════════════════════════════════════

package "Phase 6 -- Façade · JSON Config · Hot-Reload" #080C10 {

  class SystemTelemetryWriter #0D1318 {
    - outputFile : SafeFile
    - outputPath : string
    --
    + SystemTelemetryWriter(outputPath : string)
    + writeCpuTelemetry()    : bool
    + writeMemoryTelemetry() : bool
    + isOpen() : bool
  }

  class TelemetrySystem <<Facade>> #0D1318 {
    - logManager_    : unique_ptr~LogManager~
    - sources_       : vector~unique_ptr~ITelemetrySource~~
    - readers_       : vector~shared_ptr~void~~
    - startFns_      : vector~function~void()~~
    - stopFns_       : vector~function~void()~~
    - cpuWriter_     : unique_ptr~SystemTelemetryWriter~
    - ramWriter_     : unique_ptr~SystemTelemetryWriter~
    - writerThread_  : thread
    - writerRunning_ : atomic~bool~
    - running_       : bool
    --
    + TelemetrySystem(configPath : string)
    + start()
    + stop()
    + reload(configPath : string)
    + ~TelemetrySystem()
    - buildLogManager(cfg : json)
    - buildSources(cfg : json)
    - writerLoop()
  }

  note bottom of TelemetrySystem
    readers_ uses shared_ptr~void~
    for type erasure -- stores any
    TelemetryReader without
    a common base class.
    Config reloaded via SIGHUP signal.
  end note

}

' ═══════════════════════════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════════════════════════

' Inheritance -- Sinks
ILogSink <|.. ConsoleSinkImpl   : implements
ILogSink <|.. FileSinkImpl      : implements
ILogSink <|.. SocketSinkImpl    : implements

' Inheritance -- Sources
ITelemetrySource <|.. FileTelemetrySourceImpl    : implements
ITelemetrySource <|.. SocketTelemetrySourceImpl  : implements
ITelemetrySource <|.. SomeIPTelemetrySourceImpl  : implements

' LogMessage uses Severity
LogMessage ..> Severity : uses

' LogManager owns RingBuffer and ThreadPool
LogManager *-- RingBuffer : owns
LogManager *-- ThreadPool : owns
LogManager o-- ILogSink   : holds sinks

' TelemetryReader uses LogManager and ITelemetrySource
TelemetryReader ..> LogManager        : calls log()
TelemetryReader o-- ITelemetrySource  : reads from
TelemetryReader *-- LogFormatter      : owns

' LogFormatter uses Policies
LogFormatter ..> CpuPolicy : parameterized by
LogFormatter ..> RamPolicy : parameterized by
LogFormatter ..> GpuPolicy : parameterized by

' Policy uses enums
CpuPolicy ..> TelemetrySrc_enum  : uses
CpuPolicy ..> SeverityLvl_enum   : uses
RamPolicy ..> TelemetrySrc_enum  : uses
RamPolicy ..> SeverityLvl_enum   : uses
GpuPolicy ..> TelemetrySrc_enum  : uses
GpuPolicy ..> SeverityLvl_enum   : uses

' RAII usage
FileSinkImpl         *-- SafeFile   : owns (RAII)
FileTelemetrySourceImpl *-- SafeFile  : owns (RAII)
SocketTelemetrySourceImpl *-- SafeSocket : owns (RAII)
SocketSinkImpl       *-- SafeSocket : owns (RAII)
SystemTelemetryWriter *-- SafeFile  : owns (RAII)

' Builder and Factory
LogManagerBuilder ..> LogManager    : builds
LogManagerBuilder ..> ILogSink      : uses
LogSinkFactory    ..> ILogSink      : creates
LogSinkFactory    ..> LogSinkType_enum : uses

' Façade owns everything
TelemetrySystem *-- LogManager             : owns
TelemetrySystem o-- ITelemetrySource       : owns sources
TelemetrySystem ..> TelemetryReader        : creates & stores (type-erased)
TelemetrySystem *-- SystemTelemetryWriter  : owns (cpu + ram)
TelemetrySystem ..> LogManagerBuilder      : uses to build
TelemetrySystem ..> LogSinkFactory         : uses to create sinks

@enduml
